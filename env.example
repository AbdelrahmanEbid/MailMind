# MailMind Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Required API Keys
# =============================================================================

# Google Gemini API Key (Required)
# Get from: https://ai.google.dev/
GOOGLE_API_KEY=your_gemini_api_key_here

# LangSmith API Key (Required for monitoring)
# Get from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# =============================================================================
# Email Provider Configuration
# =============================================================================

# Primary email provider (gmail, outlook, custom)
EMAIL_PROVIDER=gmail

# Gmail API Configuration
# Get from: https://console.cloud.google.com/
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8081/callback

# Microsoft Outlook Configuration (if using outlook)
# Get from: https://portal.azure.com/
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_TENANT_ID=your_outlook_tenant_id

# =============================================================================
# LangChain/LangSmith Configuration
# =============================================================================

# LangChain Project Name
LANGCHAIN_PROJECT=mailmind

# LangChain Tracing (true/false)
LANGCHAIN_TRACING_V2=true

# LangChain API Endpoint (optional)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# Model Configuration
# =============================================================================

# Primary LLM Model
MODEL=google_genai/gemini-2.5-flash

# Model temperature (0.0 - 1.0)
MODEL_TEMPERATURE=0.1

# Maximum tokens for responses
MAX_TOKENS=2048

# =============================================================================
# System Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum search results per query
MAX_SEARCH_RESULTS=50

# Maximum email length to process (characters)
MAX_EMAIL_LENGTH=10000

# Request timeout (seconds)
TIMEOUT_SECONDS=30

# Number of retry attempts
RETRY_ATTEMPTS=3

# =============================================================================
# Performance Configuration
# =============================================================================

# Maximum concurrent operations
MAX_CONCURRENT_OPERATIONS=5

# Cache TTL (seconds)
CACHE_TTL=3600

# Enable caching (true/false)
ENABLE_CACHING=true

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key (generate a strong random key)
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Token Expiration (hours)
JWT_EXPIRATION_HOURS=24

# Enable HTTPS only (true/false)
HTTPS_ONLY=true
